# Supabase project (Settings → API). Only the publishable key is needed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of this app, used in the landing page snippet.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only features (new-lead notifications, Meta Conversions API).
# Same value as `select lh_private.set_server_secret('...')` in the database.
# LH_SERVER_SECRET=
# Encrypts the Meta token before it is saved: 32 random bytes, base64url.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# LH_ENCRYPTION_KEY=
# npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# META_GRAPH_VERSION=v24.0

# Tests only: a disposable Postgres 15+ server (see README).
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
